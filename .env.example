# ==========================================
# Video Editorial Intelligence Configuration
# ==========================================

# Server & Port Configuration
PORT=3001
VITE_API_URL=http://localhost:3001
ENVIRONMENT=development

# OpenAI Fallback (Optional for web demo)
OPENAI_API_KEY=

# ------------------------------------------
# Azure Machine Learning (SDK v2)
# ------------------------------------------
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_RESOURCE_GROUP=your-azure-resource-group
AZURE_WORKSPACE_NAME=your-azureml-workspace
AZURE_LOCATION=eastus
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-secret

# Azure ML Compute & Cluster Names
AZURE_ML_COMPUTE_CLUSTER=gpu-cluster-v100
AZURE_ML_ENVIRONMENT_NAME=video-editorial-env
AZURE_ML_EXPERIMENT_NAME=video-editorial-retention-v1

# ------------------------------------------
# Azure AI Foundry / Microsoft Foundry
# ------------------------------------------
AZURE_AI_FOUNDRY_PROJECT_CONNECTION_STRING=
AZURE_AI_FOUNDRY_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/models
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_MODEL_NAME=mistral-large-2407

# ------------------------------------------
# Local ML Inference & Pipeline Settings
# ------------------------------------------
DEFAULT_BASE_MODEL=distilbert-base-uncased
FALLBACK_TRANSCRIPTION_BACKEND=heuristic # 'whisper' or 'heuristic'
DEVICE=cpu # 'cpu', 'mps', or 'cuda'
CACHE_DIR=./outputs/cache
LOG_LEVEL=INFO

